{
  "name": "dsh-deepseek-provider",
  "version": "0.1.0",
  "description": "DSH 插件：在 Web GUI 对话输入区底部显示 DeepSeek 账户余额（总额 / 赠送 / 充值）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown && node scripts/wrap-client.mjs",
    "dev": "tsdown --watch",
    "dev:client": "node scripts/wrap-client.mjs --watch",
    "test": "node test/run-all.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
